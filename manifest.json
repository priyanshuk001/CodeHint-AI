{
  "manifest_version": 3,
  "name": "CodeHint AI",
  "version": "2.0",
  "description": "AI hints, approaches, solutions and debugging for coding problems. Works with OpenAI or Google Gemini.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://leetcode.com/problems/*",
    "https://codeforces.com/problemset/problem/*",
    "https://codeforces.com/contest/*/problem/*",
    "https://codeforces.com/gym/*/problem/*",
    "https://www.codechef.com/problems/*",
    "https://www.codechef.com/*/problems/*",
    "https://www.geeksforgeeks.org/problems/*",
    "https://practice.geeksforgeeks.org/problems/*",
    "https://www.interviewbit.com/problems/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon16_fresh.png",
      "48": "assets/icon48_fresh.png",
      "128": "assets/icon128_fresh.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "https://codeforces.com/problemset/problem/*",
        "https://codeforces.com/contest/*/problem/*",
        "https://codeforces.com/gym/*/problem/*",
        "https://www.codechef.com/problems/*",
        "https://www.codechef.com/*/problems/*",
        "https://www.geeksforgeeks.org/problems/*",
        "https://practice.geeksforgeeks.org/problems/*",
        "https://www.interviewbit.com/problems/*"
      ],
      "js": [
        "core/page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "https://codeforces.com/problemset/problem/*",
        "https://codeforces.com/contest/*/problem/*",
        "https://codeforces.com/gym/*/problem/*",
        "https://www.codechef.com/problems/*",
        "https://www.codechef.com/*/problems/*",
        "https://www.geeksforgeeks.org/problems/*",
        "https://practice.geeksforgeeks.org/problems/*",
        "https://www.interviewbit.com/problems/*"
      ],
      "js": [
        "core/registry.js",
        "core/site-utils.js",
        "core/editors.js",
        "sites/leetcode.js",
        "sites/codeforces.js",
        "sites/codechef.js",
        "sites/gfg.js",
        "sites/interviewbit.js",
        "content.js"
      ],
      "run_at": "document_end",
      "css": []
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/icon16_fresh.png",
    "48": "assets/icon48_fresh.png",
    "128": "assets/icon128_fresh.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*"
      ],
      "matches": [
        "https://leetcode.com/*",
        "https://codeforces.com/*",
        "https://www.codechef.com/*",
        "https://www.geeksforgeeks.org/*",
        "https://practice.geeksforgeeks.org/*",
        "https://www.interviewbit.com/*"
      ]
    }
  ],
  "minimum_chrome_version": "111"
}
